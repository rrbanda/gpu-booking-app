FROM registry.redhat.io/ubi10/go-toolset:10.1 AS builder

WORKDIR /opt/app-root/src

COPY server/go.mod server/go.sum ./
RUN go mod download

COPY server/*.go ./
RUN go build -o /opt/app-root/server .

FROM registry.redhat.io/ubi10/ubi-minimal:latest

RUN microdnf install -y sqlite-libs && microdnf clean all

COPY --from=builder /opt/app-root/server /usr/local/bin/server

RUN mkdir -p /data && chown 1001:0 /data
USER 1001

EXPOSE 8080

ENTRYPOINT ["server"]
