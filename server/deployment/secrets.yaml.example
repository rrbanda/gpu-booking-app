# GPU Booking Server Secrets -- EXAMPLE
# Copy to secrets.yaml, fill in real values, then: oc apply -f secrets.yaml
# DO NOT commit secrets.yaml to version control.
---
apiVersion: v1
kind: Secret
metadata:
  name: gpu-booking-server-config
type: Opaque
stringData:
  ADMIN_PASSWORD: "REPLACE_ME"
  BOOKING_WINDOW_DAYS: "30"
  KUEUE_SYNC_ENABLED: "true"
  KUEUE_SYNC_INTERVAL: "60"
---
apiVersion: v1
kind: Secret
metadata:
  name: gpu-cluster-kubeconfig
type: Opaque
stringData:
  # NOTE: insecure-skip-tls-verify is for sandbox/dev environments only.
  # Production must use certificate-authority-data with the cluster's CA.
  config: |
    apiVersion: v1
    kind: Config
    clusters:
    - cluster:
        server: https://api.<cluster-domain>:6443
        insecure-skip-tls-verify: true
      name: gpu-cluster
    contexts:
    - context:
        cluster: gpu-cluster
        namespace: <your-namespace>
      name: gpu-cluster
    current-context: gpu-cluster
    users:
    - name: gpu-cluster
      user:
        token: REPLACE_WITH_BEARER_TOKEN
