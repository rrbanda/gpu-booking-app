# Server port (default: 8080)
PORT=8080

# Path to SQLite database file (default: ./bookings.db)
DB_PATH=./bookings.db

# Admin dashboard password (default: admin)
ADMIN_PASSWORD=admin

# Number of days users can book into the future (default: 30)
BOOKING_WINDOW_DAYS=30

# Fallback user identity when running without OAuth proxy (local dev only)
DEV_USER=developer

# Enable Kueue sync to import consumed bookings from K8s (default: false)
KUEUE_SYNC_ENABLED=false

# Kueue sync polling interval in seconds (default: 60)
KUEUE_SYNC_INTERVAL=60

# Number of days to project Kueue bookings; 0 = rest of current week (default: 0)
KUEUE_BOOKING_DAYS=0
